{
  "name": "action-server",
  "version": "1.0.0",
  "main": "build/server.js",
  "scripts": {
    "build": "npm run lint; npm run build-quiet",
    "build-quiet": "tsc -p tsconfig.json",
    "clean": "rm -rf build",
    "start": "node build/server.js",
    "dev": "npm run clean && npm run build && nodemon --watch  src/**/*  -e ts --exec 'node --inspect=0.0.0.0:9229 --require ts-node/register build/server.js'",
    "test": "bash -c 'TSX_PROJECT=tsconfig.test.json node --experimental-test-module-mocks --import tsx --test tests/*.test.mts | tee action-server-test-report.log; exit ${PIPESTATUS[0]}'",
    "lint": "eslint src/**/*.ts",
    "reformat": "npx prettier --config ./.prettierrc.json -w ./src"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Action server for sequencing",
  "devDependencies": {
    "@tsconfig/node24": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "9.0.2",
    "@types/node": "24.13.3",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "eslint": "9.39.5",
    "eslint-config-sheriff": "31.4.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@nasa-jpl/plandev-actions": "1.3.0",
    "cookie": "^1.1.1",
    "express": "^5.0.1",
    "jsonwebtoken": "9.0.2",
    "pg": "^8.13.3",
    "piscina": "5.3.0",
    "winston": "^3.17.0"
  },
  "allowScripts": {
    "esbuild@0.25.11": true,
    "fsevents@2.3.3": true
  }
}
