# DEV ONLY. Identical to merlin-server/Dockerfile except that pymerlin is installed from a
# local checkout (via install.dev.sh) rather than the pinned git tag install.sh uses.
#
# merlin-server needs the same treatment as merlin-worker, and this is not optional for
# testing: the server loads pymerlin model types IN-PROCESS at model upload
# (POST /refreshActivityTypes -> MissionModelLoader.loadModelType()). Building only a dev
# worker would leave the server on the old pinned pymerlin, so model upload and simulation
# would disagree about what a cell is.
#
#   docker/graalpy/stage-local-pymerlin.sh
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml build merlin-server
FROM alpine:3.15 AS extractor

COPY merlin-server/build/distributions/*.tar /usr/src/app/server.tar
RUN mkdir /usr/src/app/extracted
RUN cd /usr/src/app && tar --strip-components 1 -xf server.tar -C extracted

FROM ghcr.io/graalvm/jdk-community:21

ENV NODE_VERSION=20.12.1
ENV NVM_DIR=/usr/src/.nvm
ENV PATH="${NVM_DIR}/versions/node/v${NODE_VERSION}/bin:${PATH}"
RUN microdnf install -y curl gzip findutils \
    && microdnf clean all \
    && mkdir -p $NVM_DIR \
    && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.0/install.sh | bash \
    &&. "$NVM_DIR/nvm.sh" \
    && nvm install -b ${NODE_VERSION} \
    && nvm use v${NODE_VERSION} \
    && nvm alias default v${NODE_VERSION} \
    && node --version \
    && npm --version

ARG GRAALPY_VERSION=25.0.2
ARG TARGETARCH
COPY docker/graalpy /tmp/graalpy
# install.dev.sh delegates to install.sh, then reinstalls pymerlin from the staged local
# source at /tmp/graalpy/pymerlin-src and fails the build if that did not take effect.
RUN GRAALPY_VERSION="${GRAALPY_VERSION}" TARGETARCH="${TARGETARCH}" bash /tmp/graalpy/install.dev.sh \
    && rm -rf /tmp/graalpy

ENV PYMERLIN_RESOURCES=/opt/pymerlin/python-resources
ENV CONSTRAINTS_DSL_COMPILER_ROOT="/usr/src/app/constraints-dsl-compiler/"
ENV CONSTRAINTS_DSL_COMPILER_COMMAND="./build/main.js"
ENV NODE_PATH="${NVM_DIR}/versions/node/v${NODE_VERSION}/bin/node"

COPY --from=extractor /usr/src/app/extracted /usr/src/app
COPY merlin-server/constraints-dsl-compiler /usr/src/app/constraints-dsl-compiler

WORKDIR /usr/src/app
ENTRYPOINT ["/usr/src/app/bin/merlin-server"]
