{
  "extends": "@tsconfig/node16-strictest-esm/tsconfig.json",
  "exclude": [
    "sequencing_file_store",
    "build",
    "cdict"
  ],
  "compilerOptions": {
    "lib": [
      "esnext"
    ],
    "allowJs": false,
    "checkJs": false,
    "module": "esnext",
    "resolveJsonModule": true,
    "ignoreDeprecations": "5.0",
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": false,
    "sourceMap": true,
    "noUncheckedIndexedAccess": false
  }
}
